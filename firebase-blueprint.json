{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile in Vending Machine Clinic",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "phone": { "type": "string", "maxLength": 20 },
        "role": { "type": "string", "enum": ["customer", "admin", "doctor"] },
        "email": { "type": "string", "maxLength": 100 },
        "healthScore": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "phone"]
    },
    "Booking": {
      "title": "Booking",
      "description": "Kiosk health test booking",
      "type": "object",
      "properties": {
        "bookingId": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "userPhone": { "type": "string", "maxLength": 20 },
        "testType": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["pending", "sample_collected", "analyzing", "completed", "cancelled"] },
        "kiosk": { "type": "string", "maxLength": 100 },
        "payment": { "type": "object" },
        "createdAt": { "type": "string" }
      },
      "required": ["bookingId", "testType", "status", "kiosk"]
    },
    "Report": {
      "title": "Report",
      "description": "Diagnostic health test report",
      "type": "object",
      "properties": {
        "reportId": { "type": "string", "maxLength": 64 },
        "bookingId": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 100 },
        "testType": { "type": "string", "maxLength": 50 },
        "glucose": { "type": "string", "maxLength": 50 },
        "cholesterol": { "type": "string", "maxLength": 50 },
        "summary": { "type": "string", "maxLength": 1000 },
        "summaryTe": { "type": "string", "maxLength": 1000 },
        "pdfUrl": { "type": "string", "maxLength": 256 },
        "status": { "type": "string", "maxLength": 30 },
        "doctorNotes": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string" }
      },
      "required": ["reportId", "bookingId", "testType", "summary"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Payment record for test bookings",
      "type": "object",
      "properties": {
        "paymentId": { "type": "string", "maxLength": 64 },
        "bookingId": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "amount": { "type": "number" },
        "method": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["success", "pending", "failed"] },
        "createdAt": { "type": "string" }
      },
      "required": ["bookingId", "amount", "method", "status"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notification alert",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 64 },
        "userId": { "type": "string", "maxLength": 128 },
        "title": { "type": "string", "maxLength": 120 },
        "titleTe": { "type": "string", "maxLength": 120 },
        "message": { "type": "string", "maxLength": 500 },
        "messageTe": { "type": "string", "maxLength": 500 },
        "type": { "type": "string", "maxLength": 50 },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "title", "message"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile information"
    },
    "/bookings/{bookingId}": {
      "schema": "Booking",
      "description": "Health test orders and kiosk appointments"
    },
    "/reports/{reportId}": {
      "schema": "Report",
      "description": "Diagnostic medical reports and AI summaries"
    },
    "/payments/{paymentId}": {
      "schema": "Payment",
      "description": "Payment transaction history"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User health alerts and updates"
    }
  }
}
